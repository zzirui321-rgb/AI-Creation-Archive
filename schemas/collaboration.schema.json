{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent collaboration manifest",
  "type": "object",
  "required": [
    "kind",
    "version",
    "roles",
    "modules",
    "bindings",
    "resources",
    "environment",
    "commands",
    "checks",
    "bootstrap"
  ],
  "properties": {
    "kind": {
      "const": "agent-collaboration"
    },
    "version": {
      "const": "2.0"
    },
    "roles": {
      "type": "object",
      "required": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "modules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner_role",
          "purpose",
          "binding_status"
        ],
        "properties": {
          "owner_role": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "binding_status": {
            "enum": [
              "unbound",
              "proposed",
              "accepted",
              "stale"
            ]
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource_id",
          "module_id",
          "locator",
          "status",
          "discovery_commit",
          "evidence",
          "accepted_by"
        ],
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1
          },
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "proposed",
              "accepted",
              "stale"
            ]
          },
          "locator": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "kind",
                  "relative_location"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "file",
                      "directory",
                      "symbol"
                    ]
                  },
                  "relative_location": {
                    "type": "string",
                    "minLength": 1
                  },
                  "symbol": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          },
          "discovery_commit": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array"
          },
          "accepted_by": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "accepted"
                }
              }
            },
            "then": {
              "properties": {
                "locator": {
                  "type": "object"
                },
                "discovery_commit": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "minItems": 1
                },
                "accepted_by": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "cwd_resource_id",
          "argv"
        ],
        "properties": {
          "cwd_resource_id": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "command_ref",
          "status"
        ],
        "properties": {
          "command_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "unconnected",
              "connected"
            ]
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "mode",
        "reference_resource_id",
        "protected_resource_ids",
        "command_refs"
      ],
      "properties": {
        "mode": {
          "const": "inherit-existing"
        },
        "reference_resource_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "protected_resource_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "command_refs": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "bootstrap": {
      "type": "object"
    }
  }
}
