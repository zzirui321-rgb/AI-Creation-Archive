{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aica.dev/schema/transfer/0.1",
  "title": "AiCA transfer bundle v0.1",
  "$ref": "#/$defs/manifest",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "size": {"type": "integer", "minimum": 0},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "archive", "artifacts"],
      "properties": {
        "format": {"const": "aica-transfer/0.1"},
        "archive": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "size"],
          "properties": {
            "path": {"const": "aica.json"},
            "sha256": {"$ref": "#/$defs/sha256"},
            "size": {"$ref": "#/$defs/size"}
          }
        },
        "artifacts": {
          "type": "array", "maxItems": 4096,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["artifact_id", "path", "sha256", "size"],
            "properties": {
              "artifact_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "pattern": "^objects/[a-f0-9]{64}$"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "size": {"$ref": "#/$defs/size"}
            }
          }
        }
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "format", "import_id", "project_id", "bundle_sha256", "archive_sha256"],
      "properties": {
        "status": {"const": "success"},
        "format": {"enum": ["aica-transfer/0.1", "aica-json/0.1"]},
        "import_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "archive_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
