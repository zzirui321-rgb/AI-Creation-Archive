              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archive Edge Id"
        },
        "explanation": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "kind",
        "id",
        "source",
        "target",
        "state",
        "archive_edge_id",
        "explanation"
      ],
      "title": "ControlEdge",
      "type": "object"
    },
    "DataBinding": {
      "additionalProperties": false,
      "properties": {
        "source_node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Node Id",
          "type": "string"
