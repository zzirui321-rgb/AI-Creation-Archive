        "target_input": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Target Input",
          "type": "string"
        }
      },
      "required": [
        "source_node_id",
        "source_output",
        "target_node_id",
        "target_input"
      ],
      "title": "DataBinding",
      "type": "object"
    },
    "DataEdge": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "data",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Target",
          "type": "string"
        },
        "state": {
          "enum": [
            "candidate",
            "verified"
          ],
          "title": "State",
          "type": "string"
        },
        "archive_edge_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Archive Edge Id"
        },
        "binding": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataBinding"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "$ref": "#/$defs/Claim"
        }
