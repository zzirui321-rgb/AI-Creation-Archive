          "type": "string"
        }
      },
      "required": [
        "op",
        "edge_id"
      ],
      "title": "DeleteEdge",
      "type": "object"
    },
    "EdgeEdit": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "upsert_edge",
          "title": "Op",
          "type": "string"
        },
        "value": {
          "discriminator": {
            "mapping": {
              "control": "#/$defs/ControlEdge",
              "data": "#/$defs/DataEdge",
              "semantic": "#/$defs/SemanticEdge"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DataEdge"
            },
            {
              "$ref": "#/$defs/ControlEdge"
            },
            {
              "$ref": "#/$defs/SemanticEdge"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "op",
        "value"
      ],
      "title": "EdgeEdit",
      "type": "object"
    },
    "JsonValue": {},
