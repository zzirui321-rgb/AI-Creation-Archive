        "source": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Target",
          "type": "string"
        },
        "state": {
          "enum": [
            "candidate",
            "verified"
