      "required": [
        "kind",
        "id",
        "source",
        "target",
        "state",
        "archive_edge_id",
        "binding",
        "explanation"
      ],
      "title": "DataEdge",
      "type": "object"
    },
    "DeleteEdge": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "delete_edge",
          "title": "Op",
          "type": "string"
        },
        "edge_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
