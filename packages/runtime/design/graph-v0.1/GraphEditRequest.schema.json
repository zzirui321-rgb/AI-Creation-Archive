{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 3000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "attributed_to": {
          "enum": [
            "user",
            "agent",
            "tool",
            "analyst",
            "unknown"
          ],
          "title": "Attributed To",
          "type": "string"
        },
        "actor_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actor Id"
        },
        "speech_act": {
          "enum": [
            "request",
            "proposal",
            "observation",
            "interpretation"
          ],
          "title": "Speech Act",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "origin": {
          "enum": [
            "rule",
            "llm",
            "human"
          ],
          "title": "Origin",
          "type": "string"
        },
        "review": {
          "enum": [
            "candidate",
            "accepted",
            "rejected"
          ],
          "title": "Review",
          "type": "string"
        }
      },
      "required": [
        "text",
        "attributed_to",
        "actor_id",
        "speech_act",
        "evidence_ids",
        "origin",
        "review"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ClaimEdit": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "replace_purpose",
          "title": "Op",
          "type": "string"
        },
        "node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "op",
        "node_id",
        "value"
      ],
      "title": "ClaimEdit",
      "type": "object"
    },
    "ControlEdge": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "control",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
