          "title": "Image Edits",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "purpose",
        "requirements",
        "source_node_ids",
        "run_ids",
        "artifact_ids",
        "evidence_ids"
