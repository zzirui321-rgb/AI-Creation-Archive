      "title": "Step",
      "type": "object"
    },
    "ValueLocator": {
      "additionalProperties": false,
      "properties": {
        "source_node_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Source Node Id",
          "type": "string"
        },
        "evidence_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Evidence Id",
          "type": "string"
        },
        "pointer": {
          "pattern": "^/",
          "title": "Pointer",
          "type": "string"
        },
        "decode": {
          "enum": [
            "identity",
            "json_string"
          ],
          "title": "Decode",
          "type": "string"
        },
        "value_pointer": {
          "title": "Value Pointer",
          "type": "string"
        }
      },
      "required": [
        "source_node_id",
        "evidence_id",
        "pointer",
        "decode",
        "value_pointer"
      ],
      "title": "ValueLocator",
      "type": "object"
    },
    "Variable": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "step_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Step Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "description": {
          "$ref": "#/$defs/Claim"
        },
        "locator": {
          "$ref": "#/$defs/ValueLocator"
        },
        "value_type": {
          "enum": [
            "string",
            "array",
            "number",
            "integer",
            "boolean",
            "object"
          ],
          "title": "Value Type",
          "type": "string"
        },
        "current_value": {
          "$ref": "#/$defs/JsonValue"
        },
        "allowed_modes": {
          "items": {
            "enum": [
              "keep",
              "override",
              "append"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Allowed Modes",
          "type": "array"
        },
        "separator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Separator"
        },
        "review": {
          "enum": [
            "candidate",
            "accepted",
            "rejected"
          ],
          "title": "Review",
          "type": "string"
        }
      },
      "required": [
        "id",
        "step_id",
        "label",
        "description",
        "locator",
        "value_type",
        "current_value",
        "allowed_modes",
        "separator",
        "review"
      ],
      "title": "Variable",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "aica-semantic-graph/0.1",
      "title": "Format",
      "type": "string"
    },
    "graph_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Graph Id",
      "type": "string"
    },
    "revision_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
