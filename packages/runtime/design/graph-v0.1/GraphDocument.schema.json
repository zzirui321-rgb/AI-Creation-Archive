          {
            "$ref": "#/$defs/EventEvidence"
          }
        ]
      },
      "maxItems": 2000,
      "title": "Evidence",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    }
  },
  "required": [
    "format",
    "graph_id",
    "revision_id",
    "parent_revision_id",
    "repository_branch_id",
    "state",
    "executable",
    "source",
    "parse",
    "nodes",
    "edges",
    "variables",
    "evidence",
    "coverage"
  ],
  "title": "GraphDocument",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aica:semantic-design:0.1:GraphDocument"
}
