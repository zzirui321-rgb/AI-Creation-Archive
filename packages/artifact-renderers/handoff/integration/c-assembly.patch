+.exec-workspace h2 { font-size: 17px; margin: 18px 0; }
+.exec-workspace input[type=file] { width: 1px; position: absolute; opacity: 0; }
+.exec-projects { display: flex; flex-wrap: wrap; gap: 10px; margin: 16px 0 24px; }
+.exec-projects a { padding: 8px 12px; border-bottom: 2px solid #3d5c68; max-width: 100%; overflow-wrap: anywhere; font-size: 12px; }
+.exec-projects a[aria-current=page] { border-color: #a2d5a4; }
+.exec-layout { display: grid; grid-template-columns: minmax(0,1fr) 320px; gap: 24px; }
+.exec-main { min-width: 0; }
+.exec-main .graph-explorer { min-height: 440px; }
+.exec-variables { border-left: 1px solid #38505b; padding-left: 20px; min-width: 0; }
+.exec-variables fieldset { border: 0; margin: 22px 0; padding: 0; min-width: 0; }
+.exec-variables legend { font-size: 13px; margin-bottom: 10px; }
+.exec-variables fieldset>div { display: flex; gap: 6px; margin: 8px 0; flex-wrap: wrap; }
+.exec-variables .button { padding: 7px 10px; font-size: 12px; }
