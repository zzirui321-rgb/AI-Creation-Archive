+.exec-variables textarea { width: 100%; min-height: 80px; resize: vertical; background: #101e27; color: #d8e2e6; border: 1px solid #405763; padding: 10px; }
+.exec-variables>label { display: flex; gap: 8px; padding: 10px 0; font-size: 12px; }
+.exec-variable-id { color: #8eabb6; font: 11px monospace; }
+.exec-stage { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin: 20px 0; }
+.exec-stage label { font-size: 12px; }
+.exec-artifacts { display: grid; gap: 20px; }
+.exec-main>.aica-artifacts, .exec-artifacts .aica-artifacts { padding: 16px; background: #f5f7f7; border-radius: 4px; }
+.exec-artifact-hash { overflow-wrap: anywhere; font: 11px/1.6 monospace; color: #a8bec8; margin: 12px 0; }
+.exec-plan { padding: 0; list-style: none; }
+.exec-plan li { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: space-between; font: 12px monospace; padding: 8px 0; overflow-wrap: anywhere; }
+.exec-plan .aica-state { font-size: 10px; padding: 4px; }
+.state-CACHE_HIT { color: #154e2e; background: #b8e4c9; }.state-RECOMPUTE { color: #634600; background: #f5d674; }.state-REBUILD { color: #174675; background: #bed8f3; }
