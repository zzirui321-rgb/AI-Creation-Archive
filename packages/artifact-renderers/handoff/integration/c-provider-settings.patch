--- /dev/null
+++ b/apps/web/src/settings.test.ts
@@ -0,0 +1,22 @@
+import { afterEach, expect, it, vi } from 'vitest';
+import { defaultSettings, imageProviderConfig, readSettings, saveSettings } from './settings';
+
+afterEach(() => vi.unstubAllGlobals());
+
+it('maps the selected endpoint and stage models without persisting the key', () => {
+  const entries = new Map<string, string>();
+  vi.stubGlobal('localStorage', { getItem: (key: string) => entries.get(key) ?? null, setItem: (key: string, value: string) => entries.set(key, value) });
+  const settings = { ...defaultSettings, image: { provider: 'sdcpp', apiBase: 'http://local.invalid/v1/images/generations', model: 'local-model', draftModel: 'draft-model', hqModel: 'final-model', timeoutSeconds: 180, allowFallback: false } };
+  saveSettings(settings);
+  expect(imageProviderConfig(readSettings(), { image: 'session-only-key', video: '' })).toEqual({ provider: 'sdcpp', api_base: settings.image.apiBase, api_key: 'session-only-key', model: 'local-model', draft_model: 'draft-model', hq_model: 'final-model', timeout_seconds: 180, allow_fallback: false });
+  expect([...entries.values()].join('')).not.toContain('session-only-key');
+});
+
+it('requires a session key for live API and permits explicitly selected offline mode', () => {
+  expect(imageProviderConfig(defaultSettings, { image: '', video: '' })).toBeUndefined();
+  expect(imageProviderConfig({ ...defaultSettings, image: { ...defaultSettings.image, provider: 'local_fallback' } }, { image: '', video: '' })?.provider).toBe('local_fallback');
+});
+
+it('preserves the default ten second deadline', () => {
+  expect(imageProviderConfig(defaultSettings, { image: 'session-key', video: '' })?.timeout_seconds).toBe(10);
+});
