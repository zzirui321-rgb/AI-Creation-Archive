+  await expect(readSemanticGraph({ projectId: 'p', importId: 'i' }, { id: 'parse', state: 'succeeded', graph_id: 'g', revision_id: 'r', error_code: null, usage: null }, new AbortController().signal)).rejects.toThrow('contract or source');
